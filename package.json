{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "pharmacy-api",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "nest build --builder rspack --path tsconfig.build.json --rspackPath rspack.config.cjs",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "prestart": "npm run build",
    "start": "node --enable-source-maps dist/main.js",
    "start:dev": "nest start --builder rspack --path tsconfig.build.json --rspackPath rspack.config.cjs --watch",
    "db:reset": "prisma migrate reset",
    "db:seed": "tsx --tsconfig tsconfig.seed.json prisma/seed.ts --seed",
    "db:seed:dev": "tsx --watch --tsconfig tsconfig.seed.json prisma/seed.ts --seed",
    "db:seed:permissions": "tsx --tsconfig tsconfig.seed.json prisma/seed.ts --permissions",
    "db:seed:translations": "tsx --tsconfig tsconfig.seed.json prisma/seed.ts --translations",
    "db:repair-sequences": "tsx --tsconfig tsconfig.seed.json prisma/seed.ts --repair-sequences",
    "db:clear": "tsx --tsconfig tsconfig.seed.json prisma/seed.ts --clear",
    "db:full-reset": "npm run db:clear && npm run db:reset",
    "start:debug": "nest start --builder rspack --path tsconfig.build.json --rspackPath rspack.config.cjs --debug --watch",
    "start:prod": "node --enable-source-maps dist/main.js",
    "lint": "eslint . --fix",
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js",
    "test:watch": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --watch",
    "test:cov": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --coverage",
    "test:datatable": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js src/common/data-table src/modules/helpers/services/db-helper.spec.ts src/modules/i18n/data-table",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "generate:dicebear": "tsx scripts/generate-dicebear.ts",
    "prebuild": "npm run generate:dicebear"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts --seed"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1155.0",
    "@aws-sdk/s3-request-presigner": "^3.1155.0",
    "@better-auth/api-key": "^1.7.12",
    "@better-auth/i18n": "^1.7.12",
    "@better-auth/infra": "^0.4.22",
    "@better-auth/passkey": "^1.7.12",
    "@casl/ability": "^7.0.2",
    "@dicebear/converter": "^10.7.0",
    "@dicebear/core": "^10.7.0",
    "@dicebear/styles": "^10.6.0",
    "@emailcheck/email-validator-js": "^5.1.0",
    "@nestjs/axios": "^12.0.1",
    "@nestjs/common": "^12.2.0",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.2.0",
    "@nestjs/jwt": "^12.0.3",
    "@nestjs/platform-express": "^12.2.0",
    "@nestjs/swagger": "^12.0.2",
    "@nestjs/throttler": "^6.7.1",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@react-email/render": "^2.1.1",
    "@resvg/resvg-js": "^2.6.2",
    "@thallesp/nestjs-better-auth": "^2.8.0",
    "axios": "^1.20.0",
    "bcrypt": "^6.0.0",
    "better-auth": "^1.7.12",
    "cbor": "^10.0.12",
    "clamscan": "^2.4.0",
    "deepmerge-ts": "^8.0.2",
    "dotenv": "^18.0.8",
    "farmhash": "^5.0.1",
    "form-data": "^4.0.6",
    "http-status-codes": "^2.3.0",
    "lru-cache": "^11.5.3",
    "luxon": "^3.7.2",
    "multer": "^2.4.0",
    "nanoid": "^6.0.2",
    "nestjs-cls": "^7.0.1",
    "nestjs-i18n": "^10.8.5",
    "nodemailer": "^10.2.0",
    "openid-client": "^6.8.8",
    "passport": "^0.7.0",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-email": "^6.11.3",
    "reflect-metadata": "^0.2.2",
    "resend": "^6.34.1",
    "rxjs": "^7.8.2",
    "tsx": "^4.23.15",
    "ua-parser-js": "^2.0.10",
    "uuid": "^14.0.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^12.0.10",
    "@nestjs/schematics": "^12.0.10",
    "@nestjs/testing": "^12.2.0",
    "@rspack/core": "^2.2.9",
    "@swc/cli": "^0.8.1",
    "@swc/core": "^1.16.18",
    "@types/bcrypt": "^6.0.0",
    "@types/clamscan": "^2.4.1",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.5",
    "@types/nodemailer": "^8.0.2",
    "@types/passport": "^1.0.17",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^7.2.1",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "globals": "^17.13.0",
    "jest": "^30.5.2",
    "prettier": "^3.9.10",
    "prisma": "^7.10.1",
    "sharp": "^0.35.5",
    "source-map-support": "^0.5.21",
    "supertest": "^7.3.1",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsconfig-paths-webpack-plugin": "^4.2.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "webpack-node-externals": "^3.0.0",
    "zod-openapi": "^6.0.2"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts",
      "tsx"
    ],
    "rootDir": "src",
    "modulePaths": [
      "<rootDir>"
    ],
    "moduleNameMapper": {
      "^(\\.{1,2}/.*)\\.js$": "$1"
    },
    "testRegex": ".*\\.spec\\.ts$",
    "extensionsToTreatAsEsm": [
      ".ts",
      ".tsx"
    ],
    "transform": {
      "^.+\\.tsx?$": [
        "ts-jest",
        {
          "tsconfig": "tsconfig.spec.json",
          "useESM": true
        }
      ]
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.2",
    "mysql2": "^3.11.0",
    "multer": "^2.4.0",
    "better-call": "1.4.4",
    "glob": "^13.0.6",
    "braces": "^3.0.3"
  }
}
