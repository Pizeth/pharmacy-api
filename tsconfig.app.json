{
  // "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "strict": true,
    "allowJs": true,
    "jsx": "react-jsx",
    // "module": "commonjs",
    "module": "ESNext",
    // "module": "nodenext", // 👈 Allows import.meta
    // "moduleResolution": "NodeNext", // 👈 Helps resolve modern ESM paths
    "target": "ES2022", // 👈 Ensures modern JS output
    "types": ["node", "express", "express-session", "jest", "multer"],
    // "module": "ESNext",
    // "moduleResolution": "node16",
    // "module": "es2022",
    // "declaration": true,
    "declaration": false,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "sourceMap": true,
    "outDir": "./dist",
    "incremental": true,
    "skipLibCheck": true,
    "strictNullChecks": true,
    "forceConsistentCasingInFileNames": true,
    "noImplicitAny": true,
    "strictBindCallApply": true,
    "noFallthroughCasesInSwitch": true,
    "paths": {
      // "*": ["./src/*"],
      "*": ["./src/*"]
      // "app.controller": ["./src/app.controller.ts"],
      // "app.module": ["./src/app.module.ts"],
      // "app.service": ["./src/app.service.ts"],
      // "dicebear-styles.map": ["./src/dicebear-styles.map.ts"],
      // "commons/*": ["./src/commons/*"],
      // "config/*": ["./src/config/*"],
      // "decorators/*": ["./src/decorators/*"],
      // "exceptions/*": ["./src/exceptions/*"],
      // "factories/*": ["./src/factories/*"],
      // "filters/*": ["./src/filters/*"],
      // "generated/*": ["./src/generated/*"],
      // "guards/*": ["./src/guards/*"],
      // "interceptors/*": ["./src/interceptors/*"],
      // "lib/*": ["./src/lib/*"],

      // "middlewares/*": ["./src/middlewares/*"],
      // "modules/*": ["./src/modules/*"],
      // "pipes/*": ["./src/pipes/*"],
      // "types/*": ["./src/types/*"],
      // "utils/*": ["./src/utils/*"],

      // "validation/*": ["./src/validation/*"]
    },
    "moduleResolution": "bundler"
    // "moduleResolution": "nodenext"
    // "ignoreDeprecations": "6.0"
    // "moduleResolution": "node16"
  },
  "watchOptions": {
    "watchFile": "dynamicPriorityPolling",
    "watchDirectory": "dynamicPriorityPolling",
    "fallbackPolling": "dynamicPriority",
    "excludeDirectories": ["**/node_modules", "dist"]
  },
  "include": [
    "src/**/*",
    "src/types/**/*",
    "webpack-hmr.config.cjs",
    // "generate-styles.ts",
    "dicebear-styles.map.ts",
    // "prisma.config.ts",
    // "webpack-hmr.config.ts",
    "env.d.ts",
    // "prisma/seed.ts",
    "src/modules/prisma/services/prisma.service.ts",
    "scripts/generate-dicebear.ts"
  ],
  // CRUCIAL FIX: Excludes the generated Prisma files from the TypeScript Project compiler
  "exclude": [
    "node_modules",
    "dist",
    "coverage",
    "src/generated/prisma/client/**/*"
  ]
}
